---
import { MapPin, ArrowRight, Sparkles, CheckCircle2 } from '@lucide/astro';
import Instagram from './icons/Instagram.astro';

interface Props {
  artist: {
    id: string;
    data: {
      name: string;
      handle: string;
      headline: string;
      city: string;
      country: string;
      studio: string;
      styles: string[];
      badge: string;
      bookingStatus: 'Open' | 'Waitlist' | 'Books Closed' | 'Guest Spot' | 'By Referral';
      avatar: string;
      coverImage: string;
      signatureWork?: Array<{ title: string; image: string; tag?: string }>;
      instagram: string;
    };
  };
}

const { artist } = Astro.props;
const { data, id } = artist;

const statusColors = {
  Open: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300',
  Waitlist: 'border-amber-500/40 bg-amber-500/10 text-amber-300',
  'Books Closed': 'border-zinc-700 bg-zinc-800/80 text-zinc-400',
  'Guest Spot': 'border-purple-500/40 bg-purple-500/10 text-purple-300',
  'By Referral': 'border-blue-500/40 bg-blue-500/10 text-blue-300',
};
---

<div class="group relative flex flex-col overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-900/60 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-amber-500/40 hover:shadow-xl hover:shadow-black/60">
  <!-- Cover & Gallery Thumbnail -->
  <div class="relative h-48 w-full overflow-hidden bg-zinc-950">
    <img
      src={data.coverImage}
      alt={`${data.name} signature tattoo art`}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent"></div>

    <!-- Badges Container -->
    <div class="absolute top-3 inset-x-3 flex items-center justify-between gap-2">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-zinc-950/85 px-2.5 py-1 text-[10px] font-bold text-amber-300 backdrop-blur-md shadow-sm">
        <Sparkles class="h-3 w-3 text-amber-400 shrink-0" />
        <span class="truncate">{data.badge}</span>
      </span>

      <span class={`rounded-full border px-2 py-0.5 text-[10px] font-semibold backdrop-blur-md shrink-0 ${statusColors[data.bookingStatus]}`}>
        {data.bookingStatus}
      </span>
    </div>

    <!-- Avatar overlapping cover -->
    <div class="absolute -bottom-6 left-5">
      <div class="relative h-16 w-16 overflow-hidden rounded-xl border-2 border-zinc-900 bg-zinc-800 shadow-md">
        <img
          src={data.avatar}
          alt={data.name}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </div>

  <!-- Card Body -->
  <div class="flex flex-1 flex-col p-5 pt-8">
    <div class="flex items-start justify-between">
      <div>
        <h3 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors">
          <a href={`/artists/${id}`} class="after:absolute after:inset-0">
            {data.name}
          </a>
        </h3>
        <p class="text-xs font-medium text-amber-400/90">{data.handle}</p>
      </div>

      <a
        href={data.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 p-1.5 text-zinc-400 hover:text-white transition-colors"
        aria-label={`Follow ${data.name} on Instagram`}
      >
        <Instagram class="h-4 w-4" />
      </a>
    </div>

    <!-- Headline -->
    <p class="mt-2 text-xs leading-relaxed text-zinc-400 line-clamp-2">
      {data.headline}
    </p>

    <!-- Location & Studio -->
    <div class="mt-3 flex items-center gap-1.5 text-xs text-zinc-400">
      <MapPin class="h-3.5 w-3.5 text-zinc-500 shrink-0" />
      <span class="truncate">{data.city}, {data.country} · <span class="text-zinc-500">{data.studio}</span></span>
    </div>

    <!-- Style Tags -->
    <div class="mt-4 flex flex-wrap gap-1.5">
      {data.styles.slice(0, 3).map((style) => (
        <span class="rounded-md border border-zinc-800 bg-zinc-950/60 px-2 py-0.5 text-[10px] font-medium text-zinc-300">
          {style}
        </span>
      ))}
      {data.styles.length > 3 && (
        <span class="rounded-md border border-zinc-800 bg-zinc-950/60 px-1.5 py-0.5 text-[10px] font-medium text-zinc-500">
          +{data.styles.length - 3}
        </span>
      )}
    </div>

    <!-- Bottom Footer -->
    <div class="mt-5 flex items-center justify-between border-t border-zinc-800/80 pt-3 text-xs font-semibold text-zinc-400">
      <span class="text-[11px] text-zinc-500">View Master Works</span>
      <span class="inline-flex items-center gap-1 text-amber-400 group-hover:translate-x-0.5 transition-transform">
        <span>Portfolio</span>
        <ArrowRight class="h-3.5 w-3.5" />
      </span>
    </div>
  </div>
</div>
