---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  MapPin,
  ExternalLink,
  Award,
  Sparkles,
  Calendar,
  CheckCircle2,
  Share2,
  ArrowLeft,
} from '@lucide/astro';
import Instagram from '../../components/icons/Instagram.astro';

export async function getStaticPaths() {
  const artists = await getCollection('artists');
  return artists.map((artist) => ({
    params: { id: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const { data, id } = artist;

const statusColors = {
  Open: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300',
  Waitlist: 'border-amber-500/40 bg-amber-500/10 text-amber-300',
  'Books Closed': 'border-zinc-700 bg-zinc-800/80 text-zinc-400',
  'Guest Spot': 'border-purple-500/40 bg-purple-500/10 text-purple-300',
  'By Referral': 'border-blue-500/40 bg-blue-500/10 text-blue-300',
};

// Schema.org Person for Google Rich Results
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.name,
  jobTitle: 'Master Tattoo Artist',
  description: data.bio,
  image: data.avatar,
  url: `https://tattoogoat.com/artists/${id}`,
  sameAs: [data.instagram, data.bookingUrl].filter(Boolean),
  address: {
    '@type': 'PostalAddress',
    addressLocality: data.city,
    addressCountry: data.country,
  },
};
---

<BaseLayout
  title={`${data.name} (${data.handle}) | Tattoo GOAT Hall of Fame`}
  description={data.headline}
  image={data.coverImage}
  type="profile"
  schema={personSchema}
>
  <!-- Back Button Navigation -->
  <div class="border-b border-zinc-800/60 bg-zinc-950 px-4 py-3 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <a
        href="/artists"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-400 hover:text-amber-300 transition-colors"
      >
        <ArrowLeft class="h-3.5 w-3.5" />
        <span>Back to Hall of Fame</span>
      </a>
    </div>
  </div>

  <!-- Hero Cover Banner -->
  <div class="relative h-64 sm:h-96 w-full overflow-hidden bg-zinc-950">
    <img
      src={data.coverImage}
      alt={`${data.name} masterwork cover`}
      class="h-full w-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/50 to-transparent"></div>
  </div>

  <!-- Main Profile Content -->
  <div class="relative mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <!-- Header Block Overlapping Cover -->
    <div class="-mt-24 sm:-mt-32 relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-zinc-800/80">
      <div class="flex flex-col sm:flex-row items-start sm:items-end gap-6">
        <!-- Avatar -->
        <div class="relative h-32 w-32 sm:h-40 sm:w-40 overflow-hidden rounded-2xl border-4 border-zinc-950 bg-zinc-800 shadow-2xl shrink-0">
          <img
            src={data.avatar}
            alt={data.name}
            class="h-full w-full object-cover"
          />
        </div>

        <div>
          <!-- Badge and Booking Status -->
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-zinc-950/80 px-3 py-1 text-xs font-bold text-amber-300 backdrop-blur-md shadow-sm">
              <Sparkles class="h-3.5 w-3.5 text-amber-400" />
              {data.badge}
            </span>
            <span class={`rounded-full border px-3 py-0.5 text-xs font-semibold backdrop-blur-md ${statusColors[data.bookingStatus]}`}>
              Status: {data.bookingStatus}
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white">{data.name}</h1>
          <p class="mt-1 text-sm sm:text-base font-semibold text-amber-400">{data.handle} · <span class="text-zinc-400">{data.headline}</span></p>

          <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-zinc-400">
            <span class="flex items-center gap-1">
              <MapPin class="h-3.5 w-3.5 text-zinc-500" />
              {data.city}, {data.country}
            </span>
            <span>•</span>
            <span>Studio: <strong class="text-zinc-200">{data.studio}</strong></span>
            {data.experienceYears && (
              <>
                <span>•</span>
                <span>{data.experienceYears}+ Years Active</span>
              </>
            )}
          </div>
        </div>
      </div>

      <!-- Action CTAs -->
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={data.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-zinc-700 bg-zinc-900/90 px-5 py-2.5 text-xs font-bold text-white transition-all hover:bg-zinc-800 hover:border-zinc-500"
        >
          <Instagram class="h-4 w-4" />
          <span>Follow on Instagram</span>
        </a>

        {data.bookingUrl && (
          <a
            href={data.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 px-6 py-2.5 text-xs font-bold text-black shadow-lg shadow-amber-500/20 transition-all hover:scale-105"
          >
            <span>Consultation & Books</span>
            <ExternalLink class="h-3.5 w-3.5" />
          </a>
        )}
      </div>
    </div>

    <!-- Details Grid -->
    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-3">
      <!-- Left Column: Bio & Signature Gallery -->
      <div class="lg:col-span-2 space-y-12">
        <!-- Biography -->
        <div>
          <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
            <Award class="h-5 w-5 text-amber-400" />
            <span>Curatorial Biography</span>
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-zinc-300">
            {data.bio}
          </p>
        </div>

        <!-- Signature Work Gallery -->
        {data.signatureWork && data.signatureWork.length > 0 && (
          <div>
            <h2 class="text-xl font-bold text-white mb-4">
              Iconic Pieces & Masterworks
            </h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {data.signatureWork.map((work) => (
                <div class="group relative overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/40">
                  <div class="aspect-4/3 w-full overflow-hidden bg-zinc-950">
                    <img
                      src={work.image}
                      alt={work.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-3 bg-zinc-950/80 backdrop-blur-sm border-t border-zinc-800/80">
                    <p class="text-xs font-bold text-white">{work.title}</p>
                    {work.tag && <p class="text-[10px] text-amber-400/90">{work.tag}</p>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Sidebar Info & Badges -->
      <div class="space-y-8">
        <!-- Style Specializations -->
        <div class="rounded-2xl border border-zinc-800/80 bg-zinc-900/50 p-6">
          <h3 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-4">
            Movement Specializations
          </h3>
          <div class="flex flex-wrap gap-2">
            {data.styles.map((style) => (
              <a
                href={`/artists?style=${encodeURIComponent(style)}`}
                class="rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-1 text-xs font-medium text-amber-200 hover:border-amber-400 transition-colors"
              >
                {style}
              </a>
            ))}
          </div>
        </div>

        <!-- Awards & Accolades -->
        {data.awards && data.awards.length > 0 && (
          <div class="rounded-2xl border border-zinc-800/80 bg-zinc-900/50 p-6">
            <h3 class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-4 flex items-center gap-1.5">
              <Sparkles class="h-3.5 w-3.5" />
              <span>Recognitions & Honors</span>
            </h3>
            <ul class="space-y-3">
              {data.awards.map((award) => (
                <li class="flex items-start gap-2 text-xs text-zinc-300">
                  <CheckCircle2 class="h-4 w-4 text-amber-400 shrink-0 mt-0.5" />
                  <span>{award}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Studio Location Card -->
        <div class="rounded-2xl border border-zinc-800/80 bg-zinc-900/50 p-6">
          <h3 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-2">
            Resident Studio
          </h3>
          <p class="text-sm font-bold text-white">{data.studio}</p>
          <p class="text-xs text-zinc-400 mt-1">{data.city}, {data.country}</p>
          <p class="mt-4 text-[11px] text-zinc-500 leading-relaxed">
            Appointments must be requested directly through the artist's verified portal or guest spot announcements.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
